rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public profile photos — anyone can read (rendered in shared contexts like
    // affiliate dashboards). Only the owner can upload/modify their own.
    match /profilePhotos/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Tutorial screenshots — public read (rendered in the in-app tutorial for
    // every user). Only admins can upload/modify.
    match /tutorialScreenshots/{file} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.email == "help@rentingradar.com" ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true);
    }

    // Operations file uploads — scoped to the user's UID. Covers ops field
    // uploads (contracts, insurance, photos, etc.) PLUS maintenance request
    // attachments, purchase receipts, AirBNB case files, and review files —
    // all live under operations/{uid}/{recId}/<filename>.
    match /operations/{uid}/{recId}/{file} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.email == "help@rentingradar.com");
    }

    // Business expense receipts — Financials section in Admin. Scoped to UID
    // because the expense data lives under users/{uid}/businessExpenses/{id}.
    // New unsaved expenses use the literal segment 'new' as the expenseId; the
    // file gets re-pathed by the client on save (see _finUploadReceipt).
    match /expenses/{uid}/{expenseId}/{file} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.email == "help@rentingradar.com");
    }

    // Affiliate payout proof screenshots — Financials → Affiliate section. Scoped
    // to UID because payout records live under users/{uid}/affiliatePayouts/{id}.
    // New unsaved payouts use the literal segment 'new' as the payoutId; files are
    // re-pathed by the client on save (see _finUploadPayoutProof).
    match /affiliatePayouts/{uid}/{payoutId}/{file} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.email == "help@rentingradar.com");
    }

    // Chat attachments (images/files exchanged in the support chat). Scoped by
    // conversationId so both the conversation owner AND any admin (replying as
    // support) can read & write to the same folder without permission gymnastics.
    match /chatAttachments/{convId}/{file} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == "help@rentingradar.com" ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true ||
        firestore.get(/databases/(default)/documents/chatConversations/$(convId)).data.userId == request.auth.uid
      );
    }

    // Knowledge-base screenshots that Sabrina (the AI) attaches to her replies
    // when explaining a UI feature. Authored by admins; visible to any signed-in
    // user (since the AI surfaces them in responses to support questions).
    match /chatKnowledgeScreenshots/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == "help@rentingradar.com" ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true
      );
    }

    // Support Profile photos — admin support reps' headshots that appear next
    // to their reply messages in user chats. Scoped per admin uid; readable by
    // any signed-in user (the photo is rendered in cross-user chat views).
    match /chatSupportProfilePhotos/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && (
        request.auth.token.email == "help@rentingradar.com" ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true
      );
    }
  }
}
